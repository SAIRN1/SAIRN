{
  "_comment": "Copy to testint.config.json and point it at your repo. Globs are relative to `root`; a relative `root` is relative to THIS FILE, never to the current working directory.",
  "root": "../..",
  "tests": [
    "tests/**/*.js",
    "tests/**/*.py",
    "api/**/*.test.js"
  ],
  "sources": [
    "*.html",
    "api/**/*.js",
    "tools/**/*.py",
    "sql/**/*.sql"
  ],
  "checkers": [
    "tools/control_char_check.py",
    "tools/literal_drift_check.py",
    "tools/md_table_check.py"
  ],
  "allow": "testint.allow.example.json",
  "determinism": {
    "seeds": [
      "1",
      "7",
      "12345"
    ],
    "targets": [
      "sairnvet.html",
      "sairncode.html"
    ],
    "timeout": 600
  }
}
