{
  "outputStyle": "silent",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(node --check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(curl -s https://raw.githubusercontent.com/SAIRN1/*)",
      "Bash(wc -c:*)",
      "Bash(wc -l:*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npx vercel:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git push*master*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/html_script_check.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/deploy_verify_notify.py",
            "if": "Bash(git push*)",
            "async": true,
            "asyncRewake": true,
            "timeout": 90,
            "statusMessage": "Verifying live deploy..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/git_push_master_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/redaction_check.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreCompact\",\"additionalContext\":\"PreCompact fired: if a StoneDesk handoff is overdue (see sairn-session-handoff skill), write SAIRN-SESSION-N-HANDOFF.md now -- self-contained, independently re-verified -- before this compaction erases working context.\"},\"suppressOutput\":true}'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
