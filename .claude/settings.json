{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(node --check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(curl -s https://raw.githubusercontent.com/SAIRN1/*)",
      "Bash(wc -c:*)",
      "Bash(wc -l:*)",
      "Write",
      "Edit"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git push*master*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npx vercel:*)"
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {},
  "outputStyle": "silent",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
