{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(node --check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(curl -s https://raw.githubusercontent.com/SAIRN1/*)",
      "Bash(wc -c:*)",
      "Bash(wc -l:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git push*master*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npx vercel:*)"
    ]
  },
  "model": "sonnet",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/SAIRN/tools/html_script_check.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/SAIRN/tools/deploy_verify_notify.py",
            "if": "Bash(git push*)",
            "timeout": 90,
            "statusMessage": "Verifying live deploy...",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/SAIRN/tools/git_push_master_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/SAIRN/tools/redaction_check.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreCompact\",\"additionalContext\":\"PreCompact fired: if a SAIRN handoff is overdue (see sairn-session-handoff skill), write it NOW -- self-contained, independently re-verified -- before this compaction erases working context. Naming is APP-YYYY-MM-DD-subject-handoff.md, for example SAIRNCARE-2026-08-24-resend-handoff.md. Do NOT use SAIRN-SESSION-N-HANDOFF.md; that counter scheme was retired 2026-08-23 after two different real SAIRNLAW-SESSION6 files existed at once and a session read the wrong one. Write it inside a real clone (Documents/SAIRN-hank, Documents/SAIRN-cc, Documents/SAIRN-cody), never in the home directory, and it is not written until it is committed in the same action.\"},\"suppressOutput\":true}'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/SAIRN/tools/session_lock_check.py start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/SAIRN/tools/session_lock_check.py heartbeat",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "outputStyle": "silent",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
