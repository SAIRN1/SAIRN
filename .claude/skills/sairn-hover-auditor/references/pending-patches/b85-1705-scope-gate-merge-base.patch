+    g(a, 'checkout', '-q', '-b', 'main')
+    seed = put(a, 'seed.txt', 'seed\n')
+    g(a, 'push', '-q', 'origin', 'main')
+    b = os.path.join(base, 'b')
+    g(base, 'clone', '-q', bare, b)
+    other = put(b, 'docs/BYPASS-LOG.jsonl', 'other session\n')
+    g(b, 'push', '-q', 'origin', 'main')
+    mine = put(a, '.claude/skills/sairn-hover-auditor/tools/x.py', 'mine\n')
+    g(a, 'fetch', '-q', 'origin')
+    here = os.getcwd()
+    try:
+        os.chdir(a)
+        line = 'refs/heads/main %s refs/heads/main %s\n' % (mine, other)
