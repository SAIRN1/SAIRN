+               GIT_COMMITTER_NAME='fx', GIT_COMMITTER_EMAIL='f@x')
+
+    def g(cwd, *a):
+        r = subprocess.run(['git'] + list(a), cwd=cwd, capture_output=True,
+                           text=True, env=env)
+        if r.returncode != 0:
+            raise RuntimeError('git %s: %s' % (' '.join(a), r.stderr.strip()))
+        return r.stdout.strip()
+
+    def put(repo, rel, text):
+        p = os.path.join(repo, rel)
+        os.makedirs(os.path.dirname(p) or repo, exist_ok=True)
+        with open(p, 'w', encoding='utf-8') as f:
+            f.write(text)
+        g(repo, 'add', '-A')
+        g(repo, 'commit', '-q', '-m', 'fx ' + rel)
+        return g(repo, 'rev-parse', 'HEAD')
+
