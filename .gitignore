.claude/settings.local.json
.env.local
.vercel
.env*
node_modules
.superpowers/

# graphify generated artifacts
# Rebuild: graphify extract <clone> --code-only --force --out <clone>
# The wildcard is deliberate. `graphify-out/` alone matched only the exact
# name, so a renamed variant kept during a rebuild (graphify-out.v0931/)
# showed up as untracked and was one `git add -A` away from committing a
# multi-MB generated graph. Any graphify-out* directory is generated output.
graphify-out/
graphify-out*/
__pycache__/

# Local-only SQL scratch files (probe seeds, round-trip cleanups).
# These carry real license_hash values and one-off test job IDs; they are
# working notes for a single live verification, not schema the platform runs.
sql/_scratch_*

# A blind-review round in progress. The SEALED answers must never be committed:
# a reviewer who can read them in the repo is not reviewing blind, and the
# round would produce a measured agreement rate that means nothing.
.blind-review-sealed.json

# TLC's working directory and the third-party jar tools/run_tlc.py needs.
# The jar is 2.3MB and fetched on demand -- run_tlc.py prints the curl line
# and exits 2 when it is absent, which is COULD NOT RUN and never a pass.
docs/spec/states/
tools/vendor/

# Credential files must never be swept in by a `git add -A`. A GitHub PAT
# reached a commit on 2026-09-28 exactly that way and the push gate caught it.
.claude/github_pat*
.claude/*token*
.claude/*secret*

# Demo credentials, read by tools/demo_credentials_check.py. NEVER COMMITTED.
# The tool has no fallback and no default: if this file is absent it exits 2
# COULD NOT RUN rather than reporting a clean sweep of nothing.
.demo-credentials.local.json

# ── PER-CLONE RUNTIME STATE FROM report_only_checks.py, 2026-10-07 (cc) ─────
# COMMITTING THESE WAS MY MISTAKE AND THE LOOP IS WHAT SHOWED IT. The hook runs
# one shard per push and persists which one, so EVERY push rewrites both files
# and every push after a commit of them leaves the tree dirty again. I committed
# them three times in a row before noticing the shape.
#
# THE REASON TO IGNORE RATHER THAN KEEP COMMITTING IS NOT THE NOISE, IT IS THAT
# THEY ARE WRONG AS SHARED RECORDS. A committed rotation position makes every
# other clone inherit MY place in the rotation on its next pull -- so two clones
# would run the same shard and skip another, which is the opposite of what the
# rotation is for. And the marker records whether a sweep IN THIS CLONE was
# killed; that is a fact about this clone's last run and about nothing else.
#
# The REACHABILITY file stays tracked on purpose: it is a MEASUREMENT of the
# registry, which is shared, and `--list` annotates every entry from it.
docs/report-only-shard-state.txt
docs/report-only-sweep-marker.txt
