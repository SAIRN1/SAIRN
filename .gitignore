.claude/settings.local.json
.env.local
.vercel
.env*
node_modules
.superpowers/

# graphify generated artifacts
# Rebuild: graphify extract <clone> --code-only --force --out <clone>
# The wildcard is deliberate. `graphify-out/` alone matched only the exact
# name, so a renamed variant kept during a rebuild (graphify-out.v0931/)
# showed up as untracked and was one `git add -A` away from committing a
# multi-MB generated graph. Any graphify-out* directory is generated output.
graphify-out/
graphify-out*/
__pycache__/

# Local-only SQL scratch files (probe seeds, round-trip cleanups).
# These carry real license_hash values and one-off test job IDs; they are
# working notes for a single live verification, not schema the platform runs.
sql/_scratch_*

# A blind-review round in progress. The SEALED answers must never be committed:
# a reviewer who can read them in the repo is not reviewing blind, and the
# round would produce a measured agreement rate that means nothing.
.blind-review-sealed.json

# TLC's working directory and the third-party jar tools/run_tlc.py needs.
# The jar is 2.3MB and fetched on demand -- run_tlc.py prints the curl line
# and exits 2 when it is absent, which is COULD NOT RUN and never a pass.
docs/spec/states/
tools/vendor/
