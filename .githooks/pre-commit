#!/bin/sh
# .githooks/pre-commit
#
# ONE JOB: keep the hover auditor's core rule -- "never write, edit, or push
# platform code" -- from depending on the auditor remembering it. The auditor
# is the only role here with no second reader, which is exactly the condition
# its own skill file cites Barings and Arthur Andersen for.
#
# IN EVERY OTHER CLONE THIS COSTS ONE FILE TEST AND EXITS. The marker lives in
# .git/, which is not versioned, so no build clone can inherit it by pulling
# and none of them pay for a Python start-up on every commit. That shell test
# is deliberately the first thing here rather than a check inside the Python:
# .githooks/ is shared by all four build clones and a pre-commit hook that
# costs real time on every commit is one somebody eventually turns off.
#
# Arm the auditor's clone with:
#     python tools/hover_auditor_scope_gate.py --install
#
# INSTALL (per clone, once, same as pre-push): python tools/install_git_hooks.py
#
# ── TWO GUARDS LOOKED THE SAME AND ARE NOT (fixed 2026-09-29) ─────────────
# This file used `|| exit 0` on THREE lines and they are not one thing:
#
#   SCOPE      `[ -f "$GITDIR/sairn-hover-auditor-clone" ] || exit 0`
#              asks DOES THIS GATE APPLY HERE. In a build clone it genuinely
#              does not, and exiting 0 is correct. UNCHANGED, deliberately --
#              "fixing" it would refuse every commit in four clones, which is a
#              far worse bug than the one below.
#
#   DEPENDENCY `ROOT=$(git rev-parse ...) || exit 0` asks CAN I CHECK AT ALL.
#              Exiting 0 there is a pass nobody performed, and worse: without
#              GITDIR the SCOPE test cannot run either, so a discovery failure
#              silently disarmed the auditor gate in the one clone it exists
#              for. If we cannot tell whether this is the hover clone, we
#              cannot say the gate does not apply. Those now REFUSE.
#
# `exec` is gone for the same reason it was removed from prepare-commit-msg: it
# replaced the shell with the first checker, so any second check added later
# would have looked correct and never run.

ROOT=$(git rev-parse --show-toplevel)
GITDIR=$(git rev-parse --git-dir)
if [ -z "$ROOT" ] || [ -z "$GITDIR" ]; then
  echo "pre-commit: REFUSED -- git gave no repository root or git-dir, so the" >&2
  echo "  hover-auditor scope gate could not even determine whether it applies." >&2
  echo "  Could-not-tell is not a pass." >&2
  exit 1
fi

# ── LIVE-PROBE OBLIGATIONS, ON THE COMMIT THAT ADDS ONE (2026-09-29) ───────
# tools/live_probe_residue_audit.py is recorded NOT-PROMOTED in
# report_only_checks.py, and the reason is right: its subject changes only when
# somebody WRITES a live probe, so a run on every push would report the same
# seven writers for ever -- the always-passing checker that registry has a name
# for. That entry says what it should be instead, in its own words: *"IT IS A
# PRE-COMMIT QUESTION for whoever adds a live probe."* Nothing implemented that
# sentence, so the obligations lived in a convention document, which is exactly
# where THE RULE IT ENFORCES had already failed to live once -- a SQL comment
# saying "the fix is the licence, not the pin" that four probes never met.
#
# SCOPED TO THE COMMIT, TWICE OVER, so this stays free on the commits it has
# nothing to say about: the staged set must contain a .py/.js under
# tools/ tests/ scripts/, AND one of those staged files must actually name the
# live host. An ordinary commit pays one `git diff --cached` and one grep.
# Measured 0.40s for the audit itself when it does run.
#
# THIS BLOCK IS BEFORE THE HOVER SCOPE TEST DELIBERATELY. That test exits 0 in
# all four build clones, and the build clones are the ones that write probes.
# ── TWO STATUSES, SEPARATED (2026-10-05) ────────────────────────────────────
# This was one pipeline with `|| true` on the end:
#
#   STAGED_PROBES=$(git diff --cached ... | grep -E '...' || true)
#
# `|| true` applies to the WHOLE PIPELINE, so it swallowed two different
# answers as one:
#
#   * grep exiting 1 because NOTHING MATCHED -- legitimate, and the reason the
#     `|| true` was there at all: "no staged probe files" is a real, empty,
#     correct result.
#   * `git diff --cached` FAILING -- not legitimate. That is "could not
#     check", and the hook then saw an empty STAGED_PROBES and skipped the
#     live-probe-residue audit in silence. FROM A HOOK THAT IS A PASS NOBODY
#     PERFORMED, which is the one thing `exit 0` must never mean here.
#
# It is the same class as the two reading errors recorded on 2026-10-04/05 --
# A STATUS READ OFF THE WRONG SUBJECT -- and it was the highest-consequence
# instance on the platform, because it sits in a git hook. Found by asking why
# fail_open_scan.py's dependency count had risen from 17 to 19:
# `.githooks/pre-commit:70` was one of only TWO genuinely new sites, and it
# also took hook_failopen from 0 to 1.
#
# So git's status is checked on its own, and only THEN is the list filtered.
# A git failure now refuses the commit with a reason instead of skipping an
# audit quietly; grep finding nothing is still just an empty list.
if ! STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM); then
  echo "pre-commit: could not read the staged file list (git diff --cached failed)." >&2
  echo "  REFUSING rather than skipping: an empty list and an unreadable one are" >&2
  echo "  different answers, and only one of them means 'no probes were staged'." >&2
  exit 1
fi
# grep's own status is deliberately discarded HERE and only here -- exit 1 from
# grep means "no match", which is a correct empty result for this question.
STAGED_PROBES=$(printf '%s\n' "$STAGED_ALL" \
  | grep -E '^(tools|tests|scripts)/.*\.(py|js)$' || true)
if [ -n "$STAGED_PROBES" ]; then
  HITS=""
  for f in $STAGED_PROBES; do
    [ -f "$ROOT/$f" ] || continue
    if grep -q 'sairn\.vercel\.app' "$ROOT/$f"; then HITS="yes"; break; fi
  done
  if [ -n "$HITS" ]; then
    command -v python >/dev/null 2>&1 && PYP=python || PYP=python3
    if ! command -v "$PYP" >/dev/null 2>&1; then
      echo "pre-commit: REFUSED -- this commit stages a file that addresses the" >&2
      echo "  live platform and no python is on PATH, so the live-probe" >&2
      echo "  obligations were not checked. Could-not-run is not a pass." >&2
      exit 1
    fi
    if [ ! -f "$ROOT/tools/live_probe_residue_audit.py" ]; then
      echo "pre-commit: REFUSED -- this commit stages a file that addresses the" >&2
      echo "  live platform and tools/live_probe_residue_audit.py is MISSING," >&2
      echo "  so nothing checked its class, residue or teardown." >&2
      exit 1
    fi
    "$PYP" "$ROOT/tools/live_probe_residue_audit.py" || {
      echo "" >&2
      echo "pre-commit: REFUSED -- a live-probe obligation is unmet in this" >&2
      echo "  commit. Exit 1 is a finding, exit 2 is COULD NOT RUN; both stop" >&2
      echo "  the commit and the output above says which." >&2
      exit 1
    }
  fi
fi

# SCOPE, NOT DEPENDENCY. Absent marker = this is not the auditor's clone.
[ -f "$GITDIR/sairn-hover-auditor-clone" ] || exit 0

command -v python >/dev/null 2>&1 && PY=python || PY=python3
if ! command -v "$PY" >/dev/null 2>&1; then
  echo "pre-commit: REFUSED -- this IS the hover auditor's clone and no python" >&2
  echo "  is on PATH, so the scope gate did not run." >&2
  exit 1
fi
if [ ! -f "$ROOT/tools/hover_auditor_scope_gate.py" ]; then
  echo "pre-commit: REFUSED -- this IS the hover auditor's clone and" >&2
  echo "  tools/hover_auditor_scope_gate.py is MISSING, so nothing checked" >&2
  echo "  what this commit touches." >&2
  exit 1
fi

"$PY" "$ROOT/tools/hover_auditor_scope_gate.py" --pre-commit
