#!/bin/sh
# .githooks/post-rewrite
#
# ONE JOB: hand git's own old->new SHA map to the defect register, so a rebase
# stops leaving records pointing at commits that no longer exist.
#
# WHY THIS EXISTS, MEASURED RATHER THAN ASSUMED. Across one session on
# 2026-09-23/24 the push gate refused five separate pushes with the same
# diagnosis -- "A RECORD FOR THIS SUBJECT ALREADY EXISTS, citing X. That sha is
# not in this history -- a rebase or an --amend moved the commit." Every one
# was correct, none could be fixed by the gate, and each cost a round trip to
# run `defect_register.py --reseat` by hand. Four clones push into one branch;
# a rebase is the normal case, not the exception.
#
# git already knows which commit became which. `post-rewrite` is fired once,
# after a rebase or an `--amend` has completed, with exactly that mapping on
# stdin. Using it is strictly better than the subject match `--reseat` falls
# back to, which has to refuse when two records share a subject.
#
# IT NEVER FAILS THE REBASE. The tool returns 0 on every path including its own
# errors: this hook runs AFTER the operation, so exiting non-zero would undo
# nothing and only print a failure after a success. If it cannot re-seat, it
# says so and the push gate still catches the unseated record.
#
# IT DOES NOT STAGE OR COMMIT. The register is left modified in the working
# tree with one line naming it. A hook that commits on somebody's behalf puts
# their name on a change they have not read.
#
# INSTALL (per clone, once): python tools/install_git_hooks.py

# ── THE EXIT CODE IS RIGHT AND THE SILENCE WAS NOT (2026-09-29) ───────────
# The header above argues, correctly, that this hook must never fail the rebase:
# it runs AFTER the operation, so a non-zero exit undoes nothing and only prints
# a failure after a success. git ignores post-rewrite's status anyway. That
# reasoning is unchanged.
#
# WHAT WAS WRONG IS THAT IT WAS SILENT. Both guards were `|| exit 0` with no
# output, so a failed git discovery or a missing defect_register.py meant the
# re-seat simply did not happen and NOTHING SAID SO. The next signal was the
# push gate refusing with "that sha is not in this history", several steps and
# often several minutes later -- which is the exact round trip this hook was
# built to remove. A fail-open whose only symptom appears downstream is the
# most expensive kind, because the person pays for it twice.
#
# So the guards now WARN LOUDLY and still exit 0. The exit code is not the
# control here; the message is.
ROOT=$(git rev-parse --show-toplevel)
if [ -z "$ROOT" ]; then
  echo "post-rewrite: git gave no repository root, so the defect register was" >&2
  echo "  NOT re-seated after this rewrite. Run: python tools/defect_register.py --reseat" >&2
  exit 0
fi
if [ ! -f "$ROOT/tools/defect_register.py" ]; then
  echo "post-rewrite: tools/defect_register.py is MISSING, so the register was" >&2
  echo "  NOT re-seated. Records now cite commits this rewrite replaced." >&2
  exit 0
fi

command -v python >/dev/null 2>&1 && PY=python || PY=python3
if ! command -v "$PY" >/dev/null 2>&1; then
  echo "post-rewrite: no python on PATH, so the defect register was NOT" >&2
  echo "  re-seated after this rewrite." >&2
  exit 0
fi

# ── THE MAP IS READ TWICE, BY TWO PROGRAMS, AND IT HAS TO BE ────────────────
# git hands the old->new map on STDIN exactly once. Two consumers therefore
# need two copies of it, so it is captured first and fed to each -- piping it
# straight into the first would leave the second reading an empty stream and
# reporting, truthfully and uselessly, that no commit moved.
MAP=$(cat)

printf '%s\n' "$MAP" | "$PY" "$ROOT/tools/defect_register.py" --post-rewrite || {
  echo "post-rewrite: the re-seat FAILED. Records may cite commits this" >&2
  echo "  rewrite replaced. Run: python tools/defect_register.py --reseat" >&2
}

# ── THE SECOND CONSUMER, ADDED 2026-10-06 (cc) ──────────────────────────────
# The hook above has been right since 2026-09-24 and its SCOPE was one file.
# `docs/defect-density-register.json` was re-seated and nothing else was, so
# the register stayed healthy -- 546 of 564 hexish tokens on main at
# `411f29ce` -- while the PROSE documents beside it rotted. Measured the same
# day over `docs/SAIRN-OPEN-WORK-INDEX.md`'s 367 backticked SHA citations:
# 321 on main, 8 orphaned, 38 absent. 46 dead, 12.5%, across 37 rows. The
# mechanism was never the gap; the list of files it covered was.
#
# IT WRITES ONLY WHAT NOBODY ELSE IS HOLDING. Files in another session's live
# claim are PROPOSED and not touched -- a mechanical substitution is not worth
# a write race -- and generated documents are never patched, because the
# generator is the fix. Same contract as above otherwise: working tree only,
# never staged, never committed.
if [ ! -f "$ROOT/tools/doc_sha_reseat.py" ]; then
  echo "post-rewrite: tools/doc_sha_reseat.py is MISSING, so the tracking" >&2
  echo "  DOCUMENTS were not re-seated. Their SHA citations may now be dead." >&2
else
  printf '%s\n' "$MAP" | "$PY" "$ROOT/tools/doc_sha_reseat.py" --post-rewrite || {
    echo "post-rewrite: the DOCUMENT re-seat FAILED. Tracking documents may" >&2
    echo "  cite commits this rewrite replaced. Run:" >&2
    echo "  python tools/doc_sha_reseat.py --post-rewrite" >&2
  }
fi
exit 0
