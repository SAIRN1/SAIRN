#!/bin/sh
# .githooks/pre-push
#
# Runs the SAIRN push gate on the GIT OPERATION rather than on the text of the
# command that happened to trigger it.
#
# WHY THIS EXISTS. tools/sairn_push_gate_hook.py was reachable only as a Claude
# Code PreToolUse hook keyed on a Bash command matching \bgit\s+push\b.
# tools/sairn_claim.py pushes with subprocess.run(['git','push',...]) from
# Python, so no such command text ever existed and every claim/release call
# skipped all three checks. On 2026-09-01 the gate denied a sql/-touching
# commit, and `sairn_claim.py claim` pushed that same commit to origin minutes
# later. The gate was not overridden. It was never asked.
#
# git invokes this hook for EVERY push -- Bash, a Python subprocess, an IDE, a
# script that does not exist yet. That is the property the regex never had.
#
# INSTALL (per clone, once):  python tools/install_git_hooks.py
# It is not automatic: .git/ is not versioned, so a fresh clone has no hooks
# until someone points core.hooksPath at this directory.
#
# Fails OPEN on any internal error, same standard as the other hooks: a gate
# that crashes closed gets disabled, and then protects nothing.
# OVERRIDE, SCOPED FORM FIRST -- corrected 2026-10-14 (cc b12 item 2). This
# line named only `SAIRN_SEED_GATE=off`, the BLANKET form that disables every
# check in the gate, and it is a THIRD copy of the same defect cc b11 fixed
# twice: OVERRIDE_HINT in tools/sairn_push_gate_hook.py and a hardcoded copy
# in tools/register_feed_gate.py both pointed at the blanket flag while a
# design comment claimed otherwise. The sweep that found this one is the open
# item that handoff left for this batch.
#   SAIRN_SKIP=<gate> SAIRN_SKIP_WHY="..."   skips ONE named gate, reason
#                                            required. Eight gates; read
#                                            `python tools/gate_skip.py
#                                            --gates`, never this comment
#   SAIRN_GATE_EXEMPT=seed git push ...      the narrower two-push exemption;
#                                            first push refused on purpose
#   SAIRN_SEED_GATE=off git push ...         REFUSED since 2026-10-13, exit 1
#                                            on both the Bash path and this
#                                            one. Still parsed and still
#                                            LOGGED, with honoured:false --
#                                            a flag silently ignored looks
#                                            like a flag that worked
# Say so out loud whichever you use.

command -v python >/dev/null 2>&1 && PY=python || PY=python3
ROOT=$(git rev-parse --show-toplevel)
GITDIR=$(git rev-parse --git-dir)

# git exports GIT_DIR to this hook, ABSOLUTE when pushing from a linked
# worktree. Any gate or gate fixture that then runs `git -C <tempdir> init`
# re-initialises THIS repo instead -- core.bare=true in the shared .git/config
# (cc b60; reproduced with a real push --dry-run from a worktree). Every git
# call below and in the gates finds the repo from its cwd, so drop it here and
# no child of the chain inherits it.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR

# ── HOVER AUDITOR SCOPE GATE, and ONLY in the auditor's own clone ───────────
# The marker is in .git/, so it is not versioned and no build clone inherits
# it. A build clone pays one file test and then takes the original path below,
# byte for byte.
#
# THE STDIN IS READ ONCE AND REPLAYED TO BOTH, which is the whole reason this
# is not two `exec` lines. git feeds a pre-push hook its ref lines on STDIN;
# a stream is consumed by the first reader, so chaining naively would leave
# the existing push gate with an empty stdin -- and sairn_push_gate_hook.py
# treats no ref lines as nothing to check. That would have silently disabled
# all six of its checks in exchange for adding one.
# ── STDIN IS READ ONCE, UP FRONT, AND REPLAYED TO EVERY GATE ───────────────
# Three things now read these ref lines, and a stream is consumed by its first
# reader. Reading it once here is not tidiness: it is the only shape in which
# adding a gate cannot silently disable an existing one.
REFS=$(cat)

# ── GATE SELF-INTEGRITY, BEFORE ANY GATE RUNS (cc b59) ─────────────────────
# On 2026-10-27 at about 11:04, tools/sairn_push_gate_hook.py was truncated to
# 0 bytes in cc's working tree (cc b58 handoff, section 1). An EMPTY python file
# exits 0, so that gate would have passed every push while performing no check,
# which is the one failure that reports a pass it never performed (PR 1.11).
# Each gate script must therefore be non-empty AND byte-identical to its blob
# in HEAD. The gates that run are then the committed ones, and an uncommitted
# edit to a gate refuses the push until it is committed or restored. Fails
# CLOSED: a gate that HEAD does not contain, or a hash that cannot be computed,
# is a refusal.
for g in tools/hover_auditor_scope_gate.py tools/register_feed_gate.py \
         tools/copy_exactly_gate.py tools/sairn_push_gate_hook.py; do
    f="$ROOT/$g"
    if [ ! -s "$f" ]; then
        echo "REFUSED (gate self-integrity): $g is missing or EMPTY. An empty gate passes"
        echo "every push and checks nothing. Restore it: git checkout -- $g"
        exit 1
    fi
    want=$(git rev-parse -q --verify "HEAD:$g" 2>/dev/null)
    have=$(git hash-object "$f" 2>/dev/null)
    if [ -z "$want" ] || [ -z "$have" ] || [ "$want" != "$have" ]; then
        echo "REFUSED (gate self-integrity): $g does not match its committed version"
        echo "  HEAD blob: ${want:-<none>}"
        echo "  on disk  : ${have:-<could not hash>}"
        echo "Commit the change if it is intended, or restore it: git checkout -- $g"
        exit 1
    fi
done

# ── HOVER AUDITOR SCOPE GATE, and ONLY in the auditor's own clone ───────────
# The marker is in .git/, so it is not versioned and no build clone inherits it.
if [ -f "$GITDIR/sairn-hover-auditor-clone" ]; then
    printf '%s\n' "$REFS" | "$PY" "$ROOT/tools/hover_auditor_scope_gate.py" --pre-push || exit 1
fi

# ── THE REGISTER FEED GATE (item 41's pattern, on the measurement substrate) ─
# A defect closure cannot complete without feeding the defect register. Runs in
# EVERY clone, because the starvation it exists for was platform-wide: measured
# 2026-09-15, 422 `fix(` commits touching code across all history and only 51
# distinct commits cited by any record.
#
# IT CARRIES A REQUIREMENT DATE, so it cannot refuse work that predates the
# rule -- the same mechanism tools/first_article_check.py uses, for the same
# reason. Its own --backlog reports the historical gap rather than letting the
# date forgive it.
printf '%s\n' "$REFS" | "$PY" "$ROOT/tools/register_feed_gate.py" --pre-push || exit 1

# ── THE COPY-EXACTLY GATE (methodology item 43 / Ariane 5) ─────────────────
# docs/2026-09-13-cross-domain-disciplines.md item 7 has said since 2026-09-13
# that propagating a proven pattern requires an explicit re-qualification
# against the TARGET's scale, input range and criticality tier -- and until
# 2026-09-26 nothing enforced it. This is the enforcement.
#
# CALIBRATED BEFORE IT WAS WIRED IN, because a gate nobody can satisfy gets
# overridden and then it is decoration with a process around it.
# `--measure 120` over real history flags 1 commit in 120 (0.8%), and that one
# is a TRUE POSITIVE: b015ea78, where sfFence/sfRule was copied byte-identical
# from sairnbuild.html into sairncode.html and sairnvet.html, with a commit
# message reading "byte-identical copies, not variants" -- which is precisely
# the diff-proves-the-code-matches reasoning item 7 says is not enough.
#
# Its own blind lock runs FIRST on every invocation and refuses to judge a real
# range at all if the criteria cannot classify their own fixtures.
printf '%s\n' "$REFS" | "$PY" "$ROOT/tools/copy_exactly_gate.py" --pre-push || exit 1

# NOT `| exec ...`: inside a pipeline that replaces the SUBSHELL, not this
# script, and the hook's exit status is what git acts on. Plain pipeline, then
# exit with its status.
printf '%s\n' "$REFS" | "$PY" "$ROOT/tools/sairn_push_gate_hook.py" --pre-push
exit $?
