#!/bin/sh
# .githooks/pre-push
#
# Runs the SAIRN push gate on the GIT OPERATION rather than on the text of the
# command that happened to trigger it.
#
# WHY THIS EXISTS. tools/sairn_push_gate_hook.py was reachable only as a Claude
# Code PreToolUse hook keyed on a Bash command matching \bgit\s+push\b.
# tools/sairn_claim.py pushes with subprocess.run(['git','push',...]) from
# Python, so no such command text ever existed and every claim/release call
# skipped all three checks. On 2026-09-01 the gate denied a sql/-touching
# commit, and `sairn_claim.py claim` pushed that same commit to origin minutes
# later. The gate was not overridden. It was never asked.
#
# git invokes this hook for EVERY push -- Bash, a Python subprocess, an IDE, a
# script that does not exist yet. That is the property the regex never had.
#
# INSTALL (per clone, once):  python tools/install_git_hooks.py
# It is not automatic: .git/ is not versioned, so a fresh clone has no hooks
# until someone points core.hooksPath at this directory.
#
# Fails OPEN on any internal error, same standard as the other hooks: a gate
# that crashes closed gets disabled, and then protects nothing.
# Override deliberately with SAIRN_SEED_GATE=off, and say so out loud.

command -v python >/dev/null 2>&1 && PY=python || PY=python3
ROOT=$(git rev-parse --show-toplevel)
GITDIR=$(git rev-parse --git-dir)

# ── HOVER AUDITOR SCOPE GATE, and ONLY in the auditor's own clone ───────────
# The marker is in .git/, so it is not versioned and no build clone inherits
# it. A build clone pays one file test and then takes the original path below,
# byte for byte.
#
# THE STDIN IS READ ONCE AND REPLAYED TO BOTH, which is the whole reason this
# is not two `exec` lines. git feeds a pre-push hook its ref lines on STDIN;
# a stream is consumed by the first reader, so chaining naively would leave
# the existing push gate with an empty stdin -- and sairn_push_gate_hook.py
# treats no ref lines as nothing to check. That would have silently disabled
# all six of its checks in exchange for adding one.
if [ -f "$GITDIR/sairn-hover-auditor-clone" ]; then
    REFS=$(cat)
    printf '%s\n' "$REFS" | "$PY" "$ROOT/tools/hover_auditor_scope_gate.py" --pre-push || exit 1
    printf '%s\n' "$REFS" | "$PY" "$ROOT/tools/sairn_push_gate_hook.py" --pre-push
    exit $?
fi

exec "$PY" "$ROOT/tools/sairn_push_gate_hook.py" --pre-push
