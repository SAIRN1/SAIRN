{
  "buildCommand": "mkdir -p dist && cp *.html dist/ && cp stonedesk.html dist/index.html && cp sw.js dist/sw.js",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/stonedesk$",
      "dest": "/stonedesk.html"
    },
    {
      "src": "/sairnbiz$",
      "dest": "/sairnbiz.html"
    },
    {
      "src": "/sairncode$",
      "dest": "/sairncode.html"
    },
    {
      "src": "/sairnvet$",
      "dest": "/sairnvet.html"
    },
    {
      "src": "/sairnbuild$",
      "dest": "/sairnbuild.html"
    },
    {
      "src": "/sairnscape$",
      "dest": "/sairnscape.html"
    },
    {
      "src": "/sairngrounds$",
      "dest": "/sairngrounds.html"
    },
    {
      "src": "/sairndesign$",
      "dest": "/sairndesign.html"
    },
    {
      "src": "/sairnlegacy$",
      "dest": "/sairnlegacy.html"
    },
    {
      "src": "/sairnlaw$",
      "dest": "/sairnlaw.html"
    },
    {
      "src": "/sairncash$",
      "dest": "/sairncash.html"
    },
    {
      "src": "/sairndental$",
      "dest": "/sairndental.html"
    },
    {
      "src": "/sairnmechanical$",
      "dest": "/sairnmechanical.html"
    },
    {
      "src": "/sairndental-book$",
      "dest": "/sairndental-book.html"
    },
    {
      "src": "/sairndental-complaint$",
      "dest": "/sairndental-complaint.html"
    },
    {
      "src": "/sairnsenior$",
      "dest": "/sairnsenior.html"
    },
    {
      "src": "/sairncare$",
      "dest": "/sairncare.html"
    },
    {
      "src": "/sairnroofing$",
      "dest": "/sairnroofing.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sairndental/send-reminder",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/alf-alerts",
      "schedule": "0 * * * *"
    }
  ]
}
