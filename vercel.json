{
  "buildCommand": "mkdir -p dist && for f in stonedesk sairnbiz sairncode sairnvet sairnbuild sairnscape sairngrounds sairndesign sairnlegacy sairnlaw sairncash sairndental sairndental-book; do cp $f.html dist/$f.html; done && cp stonedesk.html dist/index.html && cp sw.js dist/sw.js",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/stonedesk$",
      "dest": "/stonedesk.html"
    },
    {
      "src": "/sairnbiz$",
      "dest": "/sairnbiz.html"
    },
    {
      "src": "/sairncode$",
      "dest": "/sairncode.html"
    },
    {
      "src": "/sairnvet$",
      "dest": "/sairnvet.html"
    },
    {
      "src": "/sairnbuild$",
      "dest": "/sairnbuild.html"
    },
    {
      "src": "/sairnscape$",
      "dest": "/sairnscape.html"
    },
    {
      "src": "/sairngrounds$",
      "dest": "/sairngrounds.html"
    },
    {
      "src": "/sairndesign$",
      "dest": "/sairndesign.html"
    },
    {
      "src": "/sairnlegacy$",
      "dest": "/sairnlegacy.html"
    },
    {
      "src": "/sairnlaw$",
      "dest": "/sairnlaw.html"
    },
    {
      "src": "/sairncash$",
      "dest": "/sairncash.html"
    },
    {
      "src": "/sairndental$",
      "dest": "/sairndental.html"
    },
    {
      "src": "/sairndental-book$",
      "dest": "/sairndental-book.html"
    }
  ]
}
