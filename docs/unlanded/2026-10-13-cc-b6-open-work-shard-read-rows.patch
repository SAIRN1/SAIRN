index 6667b765..c9a84165 100644
--- a/tools/open_work_shard.py
+++ b/tools/open_work_shard.py
@@ -148,6 +148,83 @@ def read_index():
     return io.open(INDEX, encoding='utf-8', errors='replace').read(), ''
 
 
+# ── THE ONE READER EVERY ROW PARSER SHOULD CALL (2026-10-13, b6 item 5) ─────
+# Fourteen tools each open docs/SAIRN-OPEN-WORK-INDEX.md -- 2,380,170 bytes --
+# and walk it for pipe rows. Every one of them pays the whole file to get the
+# rows, and every one of them re-implements the same three decisions: where the
+# table starts, which lines are separators, and how many cells a row needs.
+#
+# THIS IS THAT, ONCE. It reads the SHARDS, which are the same rows byte for
+# byte (`--check` proves it and exits 1 if it ever stops being true), and it
+# returns them with the shard and line number attached so a caller can point a
+# reader at the row rather than at the monolith.
+#
+# WHY IT FALLS BACK TO THE INDEX RATHER THAN FAILING: a clone that has not
+# fetched since the shards landed has no docs/open-work/, and a tool that
+# started returning zero rows there would report every row as absent -- which
+# for index_duplicate_check or orphan_register_check reads as CLEAN. A silent
+# zero is the one answer worse than being slow, so the fallback is loud: the
+# `source` field says which it used, and callers print it.
+def index_text(prefer_shards=True):
+    """-> (text, source): the ROWS as a document, for a tool that walks lines.
+
+    ── WHY A SYNTHETIC DOCUMENT AND NOT A REWRITE OF SEVEN PARSERS ─────────
+    Seven tools walk the index line by line with their own cell-count rules,
+    their own idea of where the table starts, and in two cases their own regex
+    for a separator. Rewriting all seven onto all_rows() would be the better
+    shape and would also mean seven simultaneous behaviour changes in tools
+    that gate pushes and feed the traceability matrix.
+    So this returns what they already expect -- a header, a separator, and the
+    rows -- assembled from the shards instead of read from a 2,380,170-byte
+    file. Each tool's own parsing is UNCHANGED, which is why the migration is
+    verifiable one tool at a time: same rows in, same findings out.
+    The prose sections of the index are NOT included, and that is the one
+    behaviour difference. It matters for exactly one caller --
+    md_table_check.py, whose subject IS the file's own pipe shape -- which is
+    therefore deliberately NOT migrated.
+    """
+    rows, source = all_rows(prefer_shards)
+    header = '| App | Item | Status | Owner | Blocked by | Next action | Sz |'
+    body = [header, '|---|---|---|---|---|---|---|']
+    body.extend(r['line'] for r in rows)
+    return NL.join(body) + NL, source
+
+
+def all_rows(prefer_shards=True):
+    """-> (rows, source). Each row: {'line', 'app', 'shard', 'lineno'}.
+
+    `source` is 'shards' or 'index', and a caller that does not print it is
+    hiding which one answered.
+    """
+    if prefer_shards and os.path.isdir(SHARD_DIR):
+        rows = []
+        for fn in sorted(os.listdir(SHARD_DIR)):
+            if not fn.endswith('.md') or fn == 'ACTIVE.md':
+                continue
+            p = os.path.join(SHARD_DIR, fn)
+            try:
+                text = io.open(p, encoding='utf-8', errors='replace').read()
+            except OSError:
+                continue
+            for i, line in enumerate(text.split(NL), start=1):
+                if (line.startswith('|') and not SEPARATOR_RE.match(line)
+                        and not HEADER_RE.match(line)):
+                    rows.append({'line': line, 'app': app_of(line),
+                                 'shard': fn, 'lineno': i})
+        if rows:
+            return rows, 'shards'
+    src, err = read_index()
+    if err:
+        return [], 'unreadable'
+    collected, _header, _stats = collect(src)
+    rows = []
+    for s in sorted(collected):
+        for line in collected[s]:
+            rows.append({'line': line, 'app': app_of(line),
+                         'shard': None, 'lineno': None})
+    return rows, 'index'
+
+
